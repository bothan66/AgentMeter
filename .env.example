AGENTMETER_TASK_ROOT=/path/to/skillsbench/tasks
# Export these variables in your shell; launchers do not auto-load this file.
AGENTMETER_HARBOR_BIN=harbor
AGENTMETER_MODEL=Qwen3.6+
AGENTMETER_AGENT=codex
AGENTMETER_AGENT_VERSION=0.153.0
OPENAI_BASE_URL=https://provider.example/v1
OPENAI_API_KEY=replace-me
CODEX_FORCE_API_KEY=1
CODEX_WIRE_API=responses
# For optional local proxy routing, use an address reachable from Docker.
# AGENTMETER_JOBS_DIR=/path/to/data/unique-run-directory
# TMPDIR=/path/to/data/tmp
